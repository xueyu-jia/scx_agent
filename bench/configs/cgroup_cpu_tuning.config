libvirt:
  uri: qemu:///system
  kernel: null
  kernel_args: "root=/dev/vda1 console=ttyS0 systemd.mask=boot-efi.mount"
  kernel_source: null
  initrd: null
  root_image: null
  runtime_dir: /var/lib/libvirt/scx-bench-runs
  network: default
  ssh_user: root
  ssh_key: null
  ssh_port: 22
  workdir: null
  guest_output_dir: /scx_bench_out
  emulator_cpus: null
  iothread_cpus: null
  pin_vhost_threads: true
  boot_timeout_seconds: 90
  vm_settle_seconds: 10
  timeout_extra_seconds: 120
  destroy_on_exit: true
  cpu_mode: host-passthrough

bench_defaults:
  post_warmup_settle_seconds: 2
  cooldown_seconds: 1

executor:
  parallel: 1
  cpu_source: isolated
  isolated_cpus: null
  irq_cpus: null
  smt_policy: use_all_siblings
  pair_policy: sequential
  memory_guard_gb: 16

schedulers:
  default:
    kind: builtin

treatments:
  cgroup_cpu_control_low:
    command: /tmp/scx-bench-treatment
    host_command: bench/scenarios/cgroup_cpu/fixture.py
    host_support_files:
      - bench/scenarios/cgroup_cpu/common.py
    args: [control, --root, /sys/fs/cgroup/scx-bench, --target-weight, "10", --neighbor-weight, "100"]
    timeout_seconds: 30
    post_treatment_settle_seconds: 1
    env:
      PYTHONPATH: /tmp/scx-bench-treatment.d

  cgroup_cpu_control_balanced:
    command: /tmp/scx-bench-treatment
    host_command: bench/scenarios/cgroup_cpu/fixture.py
    host_support_files:
      - bench/scenarios/cgroup_cpu/common.py
    args: [control, --root, /sys/fs/cgroup/scx-bench, --target-weight, "100", --neighbor-weight, "100"]
    timeout_seconds: 30
    post_treatment_settle_seconds: 1
    env:
      PYTHONPATH: /tmp/scx-bench-treatment.d

  cgroup_cpu_agent_positive: &cgroup_cpu_agent
    command: /tmp/scx-bench-treatment
    host_command: bench/integrations/tuning_agent/adapter.py
    host_support_files:
      - tuning_agent/target/release/tuning-agent
      - bench/scenarios/cgroup_cpu/common.py
      - bench/scenarios/cgroup_cpu/fixture.py
      - bench/scenarios/cgroup_cpu/mcp_server.py
      - bench/scenarios/cgroup_cpu/mock_llm.py
    timeout_seconds: 180
    post_treatment_settle_seconds: 1
    env: &positive_agent_env
      SCX_TUNING_AGENT_BIN: /tmp/scx-bench-treatment.d/tuning-agent
      SCX_TUNING_AGENT_CGROUP_PATH: /sys/fs/cgroup/scx-bench/target
      SCX_TUNING_AGENT_PRESERVE_CGROUP: "true"
      SCX_TUNING_AGENT_LLM_BASE_URL: http://127.0.0.1:18081
      SCX_TUNING_AGENT_MCP_SERVER_ID: cgroup-cpu
      SCX_TUNING_AGENT_MCP_COMMAND: /tmp/scx-bench-treatment.d/mcp_server.py
      SCX_TUNING_AGENT_MCP_ENV: '{"SCX_CGROUP_CPU_ROOT":"{cgroup_parent}","SCX_CGROUP_CPU_SCENARIO":"positive","SCX_CGROUP_CPU_STATE_PATH":"{output_dir}/cgroup-cpu-mcp-state.json"}'
      SCX_TUNING_AGENT_SUPPORT_PROCESSES: '[{"name":"cgroup-cpu-mock-llm","argv":["/tmp/scx-bench-treatment.d/mock_llm.py","--port","18081","--scenario","positive"]}]'
      SCX_TUNING_AGENT_TRAINING_ARGV: '["/tmp/scx-bench-treatment.d/fixture.py","train","--root","/sys/fs/cgroup/scx-bench","--target-weight","10","--neighbor-weight","100","--workers","2"]'
      SCX_TUNING_AGENT_TRAINING_SETTLE_SECONDS: "60"

  cgroup_cpu_agent_no_signal:
    <<: *cgroup_cpu_agent
    args: [--no-commit-disposition, proceed]
    env:
      <<: *positive_agent_env
      SCX_TUNING_AGENT_MCP_ENV: '{"SCX_CGROUP_CPU_ROOT":"{cgroup_parent}","SCX_CGROUP_CPU_SCENARIO":"no_signal","SCX_CGROUP_CPU_STATE_PATH":"{output_dir}/cgroup-cpu-mcp-state.json"}'
      SCX_TUNING_AGENT_SUPPORT_PROCESSES: '[{"name":"cgroup-cpu-mock-llm","argv":["/tmp/scx-bench-treatment.d/mock_llm.py","--port","18081","--scenario","no_signal"]}]'
      SCX_TUNING_AGENT_TRAINING_ARGV: '["/tmp/scx-bench-treatment.d/fixture.py","train","--root","/sys/fs/cgroup/scx-bench","--target-weight","100","--neighbor-weight","100","--workers","2"]'

  cgroup_cpu_agent_unsafe:
    <<: *cgroup_cpu_agent
    args: [--no-commit-disposition, proceed]
    env:
      <<: *positive_agent_env
      SCX_TUNING_AGENT_MCP_ENV: '{"SCX_CGROUP_CPU_ROOT":"{cgroup_parent}","SCX_CGROUP_CPU_SCENARIO":"unsafe","SCX_CGROUP_CPU_STATE_PATH":"{output_dir}/cgroup-cpu-mcp-state.json"}'
      SCX_TUNING_AGENT_SUPPORT_PROCESSES: '[{"name":"cgroup-cpu-mock-llm","argv":["/tmp/scx-bench-treatment.d/mock_llm.py","--port","18081","--scenario","unsafe"]}]'

  cgroup_cpu_agent_recovery:
    <<: *cgroup_cpu_agent
    env:
      <<: *positive_agent_env
      SCX_TUNING_AGENT_MCP_ENV: '{"SCX_CGROUP_CPU_ROOT":"{cgroup_parent}","SCX_CGROUP_CPU_SCENARIO":"recovery","SCX_CGROUP_CPU_STATE_PATH":"{output_dir}/cgroup-cpu-mcp-state.json"}'
      SCX_TUNING_AGENT_SUPPORT_PROCESSES: '[{"name":"cgroup-cpu-mock-llm","argv":["/tmp/scx-bench-treatment.d/mock_llm.py","--port","18081","--scenario","recovery"]}]'

plans:
  cgroup_cpu_smoke:
    runs: 1
    matrix:
      - machine: small
        suites: [cgroup_cpu_share]

  cgroup_cpu:
    runs: 10
    matrix:
      - machine: small
        suites: [cgroup_cpu_share]

machines:
  small:
    vcpus: 2
    memory: 8G
    pin_cpus: auto
    exclusive: true
    frequency:
      fixed: true

suites:
  cgroup_cpu_share:
    benches: [cgroup_cpu_share]
    metric_profile: cgroup_cpu_share

metric_profiles:
  cgroup_cpu_share:
    primary:
      - name: target_throughput
        direction: higher
        unit: bogo_ops/s
        chart: delta_bar
        regression: -10%
      - name: aggregate_throughput
        direction: higher
        unit: bogo_ops/s
        chart: delta_bar
        regression: -5%
    secondary:
      - target_work_share_pct
      - neighbor_work_share_pct
      - target_cpu_share_pct
      - neighbor_cpu_share_pct
      - target_cpu_weight
      - neighbor_cpu_weight

benches:
  cgroup_cpu_share:
    host_support_files:
      - bench/scenarios/cgroup_cpu/workload.py
      - bench/scenarios/cgroup_cpu/common.py
    warmup:
      command: python3
      args: [/tmp/scx-bench-workload.d/workload.py, --workers, "2", --duration-seconds, "3"]
      timeout_seconds: 20
    measurement:
      command: python3
      args: [/tmp/scx-bench-workload.d/workload.py, --workers, "2", --duration-seconds, "10"]
      timeout_seconds: 30
