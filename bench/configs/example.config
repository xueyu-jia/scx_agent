vng:
  kernel: /home/bob/linux-6.18/arch/x86/boot/bzImage
  user: root
  skip_modules: true
  timeout_extra_seconds: 120

schedulers:
  default:
    kind: builtin

  default_alt:
    kind: builtin

  scx_simple:
    kind: scx
    command: bench/schedulers/scx_simple
    args: []

  my_scheduler:
    kind: scx
    command: bench/schedulers/my_scheduler
    args: []

plans:
  smoke:
    runs: 1
    matrix:
      - machine: small
        suites: [cpu_smoke, latency_smoke]

  full:
    runs: 10
    matrix:
      - machine: small
        suites: [cpu_bound, io_bound, latency, service]
      - machine: medium
        suites: [cpu_bound, io_bound, latency, service]
      - machine: large
        suites: [cpu_bound, latency]

machines:
  small:
    vcpus: 2
    memory: 8G
    pin_cpus: "2-3"
    exclusive: true
    frequency:
      fixed: true

  medium:
    vcpus: 4
    memory: 32G
    pin_cpus: "2-5"
    exclusive: true
    frequency:
      fixed: true

  large:
    vcpus: 8
    memory: 128G
    pin_cpus: "2-9"
    exclusive: true
    frequency:
      fixed: true

suites:
  cpu_smoke:
    benches: [hackbench_smoke]
    metric_profile: cpu_throughput

  latency_smoke:
    benches: [schbench_smoke]
    metric_profile: latency

  cpu_bound:
    benches: [hackbench, stress_ng_cpu]
    metric_profile: cpu_throughput

  io_bound:
    benches: [fio_randread, fio_randwrite]
    metric_profile: io_perf

  latency:
    benches: [schbench]
    metric_profile: latency

  service:
    benches: [redis_benchmark]
    metric_profile: service_perf

  fairness:
    benches: [cgroup_fairness]
    metric_profile: fairness

metric_profiles:
  cpu_throughput:
    primary:
      - name: throughput
        direction: higher
        unit: ops/s
        chart: delta_bar
        regression: -3%
      - name: elapsed_time_sec
        direction: lower
        unit: s
        chart: delta_bar
        regression: +3%
    secondary:
      - cpu_utilization
      - context_switches
      - migrations

  io_perf:
    primary:
      - name: iops
        direction: higher
        unit: iops
        chart: delta_bar
        regression: -3%
      - name: p99_latency_us
        direction: lower
        unit: us
        chart: latency_bar
        regression: +8%
    secondary:
      - bandwidth_bytes_per_sec
      - cpu_utilization
      - io_pressure

  latency:
    primary:
      - name: p99_latency_us
        direction: lower
        unit: us
        chart: latency_bar
        regression: +5%
      - name: p999_latency_us
        direction: lower
        unit: us
        chart: latency_bar
        regression: +10%
    secondary:
      - throughput
      - context_switches
      - migrations

  fairness:
    primary:
      - name: cpu_share_error
        direction: lower
        unit: "%"
        chart: delta_bar
        regression: +5%
      - name: max_wait_time
        direction: lower
        unit: us
        chart: latency_bar
        regression: +10%
    secondary:
      - throughput
      - p99_latency
      - per_cgroup_runtime

  service_perf:
    primary:
      - name: throughput
        direction: higher
        unit: qps
        chart: delta_bar
        regression: -5%
      - name: elapsed_time_sec
        direction: lower
        unit: s
        chart: delta_bar
        regression: +5%
    secondary:
      - get_qps
      - set_qps

benches:
  hackbench_smoke:
    command: python3
    args: ["bench/benchmarks/hackbench.py", "--", "2", "thread", "1000"]
    timeout_seconds: 60

  schbench_smoke:
    command: python3
    args: ["bench/benchmarks/schbench.py", "--", "-m", "1", "-t", "1", "-r", "10"]
    timeout_seconds: 60

  hackbench:
    command: python3
    args: ["bench/benchmarks/hackbench.py", "--", "16", "thread", "10000"]
    timeout_seconds: 300

  stress_ng_cpu:
    command: python3
    args: ["bench/benchmarks/stress_ng.py", "--", "--cpu", "0", "--timeout", "60s", "--metrics-brief"]
    timeout_seconds: 120

  fio_randread:
    command: python3
    args: ["bench/benchmarks/fio.py", "--", "--name=randread", "--rw=randread", "--bs=4k", "--size=1G", "--runtime=60", "--time_based", "--output-format=json"]
    timeout_seconds: 120

  fio_randwrite:
    command: python3
    args: ["bench/benchmarks/fio.py", "--", "--name=randwrite", "--rw=randwrite", "--bs=4k", "--size=1G", "--runtime=60", "--time_based", "--output-format=json"]
    timeout_seconds: 120

  schbench:
    command: python3
    args: ["bench/benchmarks/schbench.py", "--", "-m", "4", "-t", "16", "-r", "60"]
    timeout_seconds: 120

  cyclictest:
    command: python3
    args: ["bench/benchmarks/generic.py", "--", "bench/workloads/cyclictest", "--duration=60s", "--quiet"]
    timeout_seconds: 120

  cgroup_fairness:
    command: python3
    args: ["bench/benchmarks/generic.py", "--", "bench/workloads/cgroup-fairness", "--duration", "60"]
    timeout_seconds: 120

  redis_benchmark:
    command: python3
    args: ["bench/benchmarks/redis.py", "--requests", "10000", "--clients", "50", "--tests", "get,set"]
    timeout_seconds: 120
