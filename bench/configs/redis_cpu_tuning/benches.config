bench_defaults:
  post_warmup_settle_seconds: 2
  cooldown_seconds: 1

metric_profiles:
  redis_cpu:
    primary:
      - name: redis_p99_latency_us
        direction: lower
        unit: us
        chart: latency_bar
        regression: +15%
      - name: redis_qps
        direction: higher
        unit: ops/s
        chart: delta_bar
        regression: -5%
    secondary:
      - redis_p50_latency_us
      - redis_p95_latency_us
      - redis_cpu_rate
      - batch_cpu_rate
      - redis_cpu_share_pct
      - batch_cpu_share_pct
      - target_cpu_weight
      - cpu_pressure_some_pct

suites:
  redis_cpu:
    benches: [redis_cpu]
    metric_profile: redis_cpu

benches:
  redis_cpu:
    host_support_files:
      - bench/scenarios/redis_cpu/workload.py
      - bench/scenarios/redis_cpu/common.py
      - bench/scenarios/redis_cpu/fixture.py
      - bench/scenarios/redis_cpu/loadgen.py
    warmup:
      command: python3
      args: [/tmp/scx-bench-workload.d/workload.py, --rounds, "2", --warmup-rounds, "1", --contention, high]
      timeout_seconds: 90
    measurement:
      command: python3
      args: [/tmp/scx-bench-workload.d/workload.py, --rounds, "7", --warmup-rounds, "2", --contention, high]
      timeout_seconds: 180
