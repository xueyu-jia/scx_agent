bench_defaults:
  post_warmup_settle_seconds: 3
  cooldown_seconds: 1

metric_profiles:
  redis_cpu_demo:
    primary:
      - name: redis_p99_latency_us
        direction: lower
        unit: us
        chart: latency_bar
      - name: redis_qps
        direction: higher
        unit: ops/s
        chart: delta_bar
        regression: -10%
    secondary:
      - redis_p50_latency_us
      - redis_p95_latency_us
      - redis_cpu_rate
      - batch_cpu_rate
      - redis_cpu_share_pct
      - batch_cpu_share_pct
      - target_cpu_weight
      - cpu_pressure_some_pct

suites:
  redis_cpu_demo:
    benches: [redis_cpu_demo]
    metric_profile: redis_cpu_demo

benches:
  redis_cpu_demo:
    host_support_files:
      - bench/scenarios/redis_cpu/workload.py
      - bench/scenarios/redis_cpu/common.py
      - bench/scenarios/redis_cpu/fixture.py
      - bench/scenarios/redis_cpu/loadgen.py
    warmup:
      command: python3
      args: [/tmp/scx-bench-workload.d/workload.py, --requests, "200000", --clients, "64", --rounds, "3", --warmup-rounds, "1", --contention, high]
      timeout_seconds: 180
    measurement:
      command: python3
      args: [/tmp/scx-bench-workload.d/workload.py, --requests, "200000", --clients, "64", --rounds, "10", --warmup-rounds, "2", --contention, high]
      timeout_seconds: 360
