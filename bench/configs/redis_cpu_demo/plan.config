schedulers:
  default:
    kind: builtin

treatments:
  redis_cpu_control:
    command: /tmp/scx-bench-treatment
    host_command: bench/scenarios/redis_cpu/fixture.py
    host_support_files:
      - bench/scenarios/redis_cpu/common.py
    args: [control, --root, /sys/fs/cgroup/scx-bench, --redis-weight, "50", --batch-weight, "100"]
    timeout_seconds: 30
    post_treatment_settle_seconds: 1
    env:
      PYTHONPATH: /tmp/scx-bench-treatment.d

  redis_cpu_agent:
    command: /tmp/scx-bench-treatment
    host_command: bench/integrations/tuning_agent/adapter.py
    host_support_files:
      - tuning_agent/target/release/tuning-agent
      - bench/integrations/tuning_agent/llm_preflight.py
      - bench/scenarios/redis_cpu/common.py
      - bench/scenarios/redis_cpu/fixture.py
      - bench/scenarios/redis_cpu/loadgen.py
      - bench/scenarios/redis_cpu/mcp_server.py
    args: [--no-commit-disposition, proceed]
    timeout_seconds: 480
    post_treatment_settle_seconds: 1
    env:
      SCX_TUNING_AGENT_BIN: /tmp/scx-bench-treatment.d/tuning-agent
      SCX_TUNING_AGENT_CGROUP_PATH: /sys/fs/cgroup/scx-bench/driver
      SCX_TUNING_AGENT_PRESERVE_CGROUP: "true"
      SCX_TUNING_AGENT_LLM_BASE_URL: https://api.deepseek.com/v1
      SCX_TUNING_AGENT_LLM_API_KEY: replace-in-local-profile
      SCX_TUNING_AGENT_LLM_MODEL: deepseek-v4-flash
      SCX_TUNING_AGENT_LLM_TIMEOUT_MS: "60000"
      SCX_TUNING_AGENT_LLM_RETRY_COUNT: "1"
      SCX_TUNING_AGENT_MAX_REASONING_ROUNDS: "12"
      SCX_TUNING_AGENT_EVALUATION_TIMEOUT_MS: "180000"
      SCX_TUNING_AGENT_MCP_REQUEST_TIMEOUT_MS: "30000"
      SCX_TUNING_AGENT_ACTIVATE_TIMEOUT_SECONDS: "300"
      SCX_TUNING_AGENT_MCP_SERVER_ID: redis-cpu
      SCX_TUNING_AGENT_MCP_COMMAND: /tmp/scx-bench-treatment.d/mcp_server.py
      SCX_TUNING_AGENT_MCP_ENV: '{"SCX_REDIS_CPU_ROOT":"{cgroup_parent}","SCX_REDIS_CPU_OUTPUT_DIR":"{output_dir}","SCX_REDIS_CPU_RUNTIME_PATH":"{output_dir}/runtime.json","SCX_REDIS_CPU_LOADGEN_STATE_PATH":"{output_dir}/loadgen-state.json","SCX_REDIS_CPU_OPERATION_STATE_PATH":"{output_dir}/redis-cpu-operations.json","SCX_REDIS_CPU_JOURNAL_PATH":"{output_dir}/redis-cpu-mcp-journal.jsonl","SCX_REDIS_CPU_RESTORE_FAILURE":"never","SCX_REDIS_CPU_ALLOWED_WEIGHTS":"[100,200,400,800]"}'
      SCX_TUNING_AGENT_TRAINING_ARGV: '["/tmp/scx-bench-treatment.d/fixture.py","train","--root","/sys/fs/cgroup/scx-bench","--redis-weight","50","--batch-weight","100","--redis-server-binary","bench/workloads/bin/redis-server","--redis-benchmark-binary","bench/workloads/bin/redis-benchmark","--stress-ng-binary","bench/workloads/bin/stress-ng","--loadgen","/tmp/scx-bench-treatment.d/loadgen.py","--requests","200000","--clients","64","--contention","high"]'
      SCX_TUNING_AGENT_TRAINING_READY_PATH: ready.json
      SCX_TUNING_AGENT_TRAINING_READY_TIMEOUT_SECONDS: "120"
      SCX_TUNING_AGENT_EVENT_TYPE: redis_cpu_demo_recover_p99_latency_at_least_5_percent_from_underweighted_redis_while_batch_cpu_rate_stays_at_least_0_5

plans:
  redis_cpu_demo_smoke:
    runs: 1
    matrix:
      - machine: small
        suites: [redis_cpu_demo]

  redis_cpu_demo:
    runs: 5
    matrix:
      - machine: small
        suites: [redis_cpu_demo]
