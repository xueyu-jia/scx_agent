# Target: openEuler 24.03 LTS SP4 / 6.6.
# bench.env init replaces machine-local paths and CPU sets.
libvirt:
  uri: qemu:///system
  kernel: /var/lib/libvirt/scx-bench-kernels/oe2403sp4_6_6_redis_cpu_demo/bzImage
  kernel_args: "root=/dev/vda1 console=ttyS0 systemd.mask=boot-efi.mount psi=1"
  kernel_source: /home/user/kernels/oe2403sp4-6.6/source/usr/src/linux-6.6
  kernel_config: /home/user/kernels/oe2403sp4-6.6/build/.config
  sync_kernel_source: false
  initrd: null
  root_image: /var/lib/libvirt/scx-bench-runs/redis-cpu-demo-oe2403sp4-6.6-base.qcow2
  runtime_dir: /var/lib/libvirt/scx-bench-runs
  network: default
  ssh_user: root
  ssh_key: /home/user/.ssh/scx-bench
  ssh_port: 22
  workdir: /home/user/scx_agent
  guest_output_dir: /scx_bench_out
  emulator_cpus: null
  iothread_cpus: null
  pin_vhost_threads: true
  boot_timeout_seconds: 90
  vm_settle_seconds: 10
  timeout_extra_seconds: 180
  destroy_on_exit: true
  cpu_mode: host-passthrough

executor:
  parallel: auto
  cpu_source: isolated
  isolated_cpus: null
  irq_cpus: null
  smt_policy: use_all_siblings
  pair_policy: sequential
  memory_guard_gb: 8

machines:
  small:
    vcpus: 6
    memory: 8G
    pin_cpus: auto
    exclusive: true
    frequency:
      fixed: true
      governor: performance
      turbo: true
