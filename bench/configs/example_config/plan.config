schedulers:
  default:
    kind: builtin

  # A second name for the same EEVDF scheduler, used only for per-group A/A.
  alt_default:
    kind: builtin

  scx_agent_classed:
    kind: scx
    command: schedule/scx_agent_classed/target/release/scx_agent_classed
    host_command: schedule/scx_agent_classed/target/release/scx_agent_classed
    args: []
    settle_seconds: 2

  scx_agent_classed_dynamic:
    kind: scx
    command: schedule/scx_agent_classed/target/release/scx_agent_classed
    host_command: schedule/scx_agent_classed/target/release/scx_agent_classed
    args: [--learned-rules, /tmp/scx-agent-classed-learned.json, --control-socket, /tmp/scx-agent-classed-control.sock]
    settle_seconds: 2

  scx_agent_classed_dynamic_diagnostic:
    kind: scx
    command: schedule/scx_agent_classed/target/release/scx_agent_classed
    host_command: schedule/scx_agent_classed/target/release/scx_agent_classed
    args: [--learned-rules, /tmp/scx-agent-classed-learned.json, --control-socket, /tmp/scx-agent-classed-control.sock, --diagnostic-counters]
    settle_seconds: 2

  # Performance candidate.  The supervisor prepares ambient rules and starts
  # the tuning-agent, while perf_classify completes discovery before warmup.
  scx_agent_classed_perf:
    kind: scx
    command: bench/integrations/tuning_agent/scx_real_llm_scheduler.py
    host_command: bench/integrations/tuning_agent/scx_real_llm_scheduler.py
    host_kconfig: /path/to/linux/.config
    host_support_files:
      - tuning_agent/target/release/tuning-agent
      - schedule/scx_agent_classed/target/release/scx_agent_classed
      - schedule/scx_agent_classed_mcp/target/release/scx_agent_classed_mcp
    args: [--kconfig, /tmp/scx-bench-kconfig]
    env:
      SCX_REAL_LLM_BASE_URL: http://192.168.122.1:17001
      SCX_REAL_LLM_MODEL: gpt-5.5
      SCX_REAL_LLM_TARGET_COMM: redis-server
      SCX_REAL_LLM_DIAGNOSTIC_COUNTERS: '0'
    settle_seconds: 2

treatments:
  deterministic_agent:
    command: /tmp/scx-bench-treatment
    host_command: bench/integrations/tuning_agent/adapter.py
    host_support_files:
      - bench/integrations/tuning_agent/mock_llm.py
      - bench/integrations/tuning_agent/deterministic_mcp.py
    args: [--no-commit-disposition, proceed]
    timeout_seconds: 900
    post_treatment_settle_seconds: 5
    env:
      SCX_TUNING_AGENT_BIN: /usr/local/bin/tuning-agent
      SCX_TUNING_AGENT_SUPPORT_PROCESSES: '[{"name":"mock-llm","argv":["/tmp/scx-bench-treatment.d/mock_llm.py","--port","18080"]}]'
      SCX_DETERMINISTIC_SCENARIO: positive

  # Both sides run the same discovery workload for an equal fixed duration.
  perf_control:
    command: /tmp/scx-bench-treatment
    host_command: bench/integrations/tuning_agent/scx_perf_treatment.py
    args:
      - --mode
      - control
      - --duration-seconds
      - '630'
      - --target
      - hackbench=batch
      - --target
      - stress-ng=batch
      - --target
      - stress-ng-cpu=batch
      - --target
      - schbench=latency
      - --target
      - redis-server=latency
      - --target
      - redis-benchmark=batch
      - --target
      - perf=batch
    timeout_seconds: 2100
    post_treatment_settle_seconds: 5
    env:
      SCX_PERF_TREATMENT_SECONDS: '630'

  perf_classify:
    command: /tmp/scx-bench-treatment
    host_command: bench/integrations/tuning_agent/scx_perf_treatment.py
    args:
      - --mode
      - classify
      - --duration-seconds
      - '630'
      - --classify-timeout-seconds
      - '90'
      - --target
      - hackbench=batch
      - --target
      - stress-ng=batch
      - --target
      - stress-ng-cpu=batch
      - --target
      - schbench=latency
      - --target
      - redis-server=latency
      - --target
      - redis-benchmark=batch
      - --target
      - perf=batch
    timeout_seconds: 2100
    post_treatment_settle_seconds: 5
    env:
      SCX_PERF_TREATMENT_SECONDS: '630'

plans:
  smoke:
    runs: 3
    matrix:
      - machine: small
        suites: [cpu_smoke, latency_smoke, context_switch]

  full:
    runs: 3
    matrix:
      - machine: small
        suites: [cpu_bound, sched_ipc, latency, realtime_latency, context_switch, os_bench, ipc, memory_latency]

  # Short warmup plan for settling the host and VM before measured plans.
  scx_agent_classed_sacrificial:
    runs: 2
    matrix:
      - machine: classed_medium
        suites: [scx_agent_classed_sacrificial]

  # Default flow-validation group. Each candidate pair starts with an empty
  # learned table and independently classifies one comm through the real LLM.
  scx_agent_classed_flow:
    runs: 3
    matrix:
      - machine: classed_medium
        suites: [scx_agent_classed_sacrificial]

  # Small performance screen: five paired runs per workload class. Candidate
  # rules are learned independently in every fresh VM before warmup.
  scx_agent_classed_small_batch:
    runs: 5
    matrix:
      - machine: classed_medium
        suites: [scx_agent_classed_small_batch]

  scx_agent_classed_small_latency:
    runs: 5
    matrix:
      - machine: classed_medium
        suites: [scx_agent_classed_perf_latency]

  scx_agent_classed_small_mixed:
    runs: 5
    matrix:
      - machine: classed_medium
        suites: [scx_agent_classed_perf_mixed]

  scx_agent_classed_perf_cpu:
    runs: 15
    matrix:
      - machine: classed_medium
        suites: [scx_agent_classed_perf_cpu]

  scx_agent_classed_perf_latency:
    runs: 20
    matrix:
      - machine: classed_medium
        suites: [scx_agent_classed_perf_latency]

  scx_agent_classed_perf_mixed:
    runs: 20
    matrix:
      - machine: classed_medium
        suites: [scx_agent_classed_perf_mixed]

  scx_agent_classed_perf_service:
    runs: 15
    matrix:
      - machine: classed_medium
        suites: [scx_agent_classed_perf_service]
