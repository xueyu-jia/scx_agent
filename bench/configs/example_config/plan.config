schedulers:
  default:
    kind: builtin
  alt_default:
    kind: builtin
  scx_agent_classed:
    kind: scx
    command: schedule/scx_agent_classed/target/release/scx_agent_classed
    host_command: schedule/scx_agent_classed/target/release/scx_agent_classed
    host_kconfig: /path/to/linux/.config
    args:
    - --rule
    - schbench=latency
    - --rule
    - stress-ng=batch
    - --rule
    - stress-ng-cpu=batch
    - --default-class
    - batch
    - --kconfig
    - /tmp/scx-bench-kconfig
    settle_seconds: 2
  scx_agent_classed_llm_latency:
    kind: scx
    command: bench/integrations/tuning_agent/scx_real_llm_scheduler.py
    host_command: bench/integrations/tuning_agent/scx_real_llm_scheduler.py
    host_kconfig: /path/to/linux/.config
    host_support_files:
    - tuning_agent/target/release/tuning-agent
    - schedule/scx_agent_classed/target/release/scx_agent_classed
    - schedule/scx_agent_classed_mcp/target/release/scx_agent_classed_mcp
    args: [--kconfig, /tmp/scx-bench-kconfig]
    env:
      SCX_REAL_LLM_BASE_URL: http://192.168.122.1:17001
      SCX_REAL_LLM_MODEL: deepseek-v4-flash
      SCX_REAL_LLM_TARGET_COMM: schbench
      SCX_REAL_LLM_ACTIVATION_COMMS: '["schbench"]'
      SCX_REAL_LLM_DIAGNOSTIC_COUNTERS: '0'
    settle_seconds: 2
  scx_agent_classed_llm_batch:
    kind: scx
    command: bench/integrations/tuning_agent/scx_real_llm_scheduler.py
    host_command: bench/integrations/tuning_agent/scx_real_llm_scheduler.py
    host_kconfig: /path/to/linux/.config
    host_support_files:
    - tuning_agent/target/release/tuning-agent
    - schedule/scx_agent_classed/target/release/scx_agent_classed
    - schedule/scx_agent_classed_mcp/target/release/scx_agent_classed_mcp
    args: [--kconfig, /tmp/scx-bench-kconfig]
    env:
      SCX_REAL_LLM_BASE_URL: http://192.168.122.1:17001
      SCX_REAL_LLM_MODEL: deepseek-v4-flash
      SCX_REAL_LLM_TARGET_COMM: stress-ng
      SCX_REAL_LLM_ACTIVATION_COMMS: '["stress-ng","stress-ng-cpu"]'
      SCX_REAL_LLM_DIAGNOSTIC_COUNTERS: '0'
    settle_seconds: 2
  scx_agent_classed_llm_mixed:
    kind: scx
    command: bench/integrations/tuning_agent/scx_real_llm_scheduler.py
    host_command: bench/integrations/tuning_agent/scx_real_llm_scheduler.py
    host_kconfig: /path/to/linux/.config
    host_support_files:
    - tuning_agent/target/release/tuning-agent
    - schedule/scx_agent_classed/target/release/scx_agent_classed
    - schedule/scx_agent_classed_mcp/target/release/scx_agent_classed_mcp
    args: [--kconfig, /tmp/scx-bench-kconfig]
    env:
      SCX_REAL_LLM_BASE_URL: http://192.168.122.1:17001
      SCX_REAL_LLM_MODEL: deepseek-v4-flash
      SCX_REAL_LLM_TARGET_COMM: schbench
      SCX_REAL_LLM_ACTIVATION_COMMS: '["schbench","stress-ng","stress-ng-cpu"]'
      SCX_REAL_LLM_DIAGNOSTIC_COUNTERS: '0'
    settle_seconds: 2

treatments:
  llm_latency_control:
    command: /tmp/scx-bench-treatment
    host_command: bench/integrations/tuning_agent/scx_perf_treatment.py
    args: [--mode, control, --duration-seconds, '120', --target, schbench=latency]
    timeout_seconds: 180
    post_treatment_settle_seconds: 5
  llm_latency_classify:
    command: /tmp/scx-bench-treatment
    host_command: bench/integrations/tuning_agent/scx_perf_treatment.py
    args: [--mode, classify, --duration-seconds, '120', --classify-timeout-seconds, '90', --target, schbench=latency]
    env: {SCX_PERF_EXPECTED_MODEL: deepseek-v4-flash}
    timeout_seconds: 180
    post_treatment_settle_seconds: 5
  llm_batch_control:
    command: /tmp/scx-bench-treatment
    host_command: bench/integrations/tuning_agent/scx_perf_treatment.py
    args: [--mode, control, --duration-seconds, '120', --target, stress-ng=batch, --target, stress-ng-cpu=batch]
    timeout_seconds: 180
    post_treatment_settle_seconds: 5
  llm_batch_classify:
    command: /tmp/scx-bench-treatment
    host_command: bench/integrations/tuning_agent/scx_perf_treatment.py
    args: [--mode, classify, --duration-seconds, '120', --classify-timeout-seconds, '90', --target, stress-ng=batch, --target, stress-ng-cpu=batch]
    env: {SCX_PERF_EXPECTED_MODEL: deepseek-v4-flash}
    timeout_seconds: 180
    post_treatment_settle_seconds: 5
  llm_mixed_control:
    command: /tmp/scx-bench-treatment
    host_command: bench/integrations/tuning_agent/scx_perf_treatment.py
    args: [--mode, control, --duration-seconds, '120', --target, schbench=latency, --target, stress-ng=batch, --target, stress-ng-cpu=batch]
    timeout_seconds: 180
    post_treatment_settle_seconds: 5
  llm_mixed_classify:
    command: /tmp/scx-bench-treatment
    host_command: bench/integrations/tuning_agent/scx_perf_treatment.py
    args: [--mode, classify, --duration-seconds, '120', --classify-timeout-seconds, '90', --target, schbench=latency, --target, stress-ng=batch, --target, stress-ng-cpu=batch]
    env: {SCX_PERF_EXPECTED_MODEL: deepseek-v4-flash}
    timeout_seconds: 180
    post_treatment_settle_seconds: 5

plans:
  kernel_migration_smoke:
    runs: 1
    matrix:
    - machine: small_core
      suites: [latency_only_perf]
  single_latency_candidate_gate:
    runs: 1
    matrix:
    - machine: small_core
      suites: [latency_only_perf]
  mixed_fixed_rps_core_priming:
    runs: 2
    matrix:
    - machine: small_core
      suites: [mixed_class_fixed_rps_perf]
  mixed_fixed_rps_core_measured:
    runs: 4
    matrix:
    - machine: small_core
      suites: [mixed_class_fixed_rps_perf]
  single_latency_core_priming:
    runs: 2
    matrix:
    - machine: small_core
      suites: [latency_only_perf]
  single_latency_core_measured:
    runs: 8
    matrix:
    - machine: small_core
      suites: [latency_only_perf]
  single_batch_core_priming:
    runs: 2
    matrix:
    - machine: small_core
      suites: [batch_only_perf]
  single_batch_core_measured:
    runs: 4
    matrix:
    - machine: small_core
      suites: [batch_only_perf]
