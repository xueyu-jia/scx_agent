bench_defaults:
  post_warmup_settle_seconds: 2
  cooldown_seconds: 1

metric_profiles:
  cpu_throughput:
    primary:
      - name: throughput
        direction: higher
        unit: ops/s
        chart: delta_bar
        regression: -3%
      - name: elapsed_time_sec
        direction: lower
        unit: s
        chart: delta_bar
        regression: +3%
    secondary:
      - cpu_utilization
      - task_clock_msec
      - context_switches
      - migrations

  sched_ipc_perf:
    primary:
      - name: throughput
        direction: higher
        unit: ops/s
        chart: delta_bar
        regression: -5%
      - name: latency_us_per_op
        direction: lower
        unit: us/op
        chart: latency_bar
        regression: +5%
      - name: elapsed_time_sec
        direction: lower
        unit: s
        chart: delta_bar
        regression: +5%
    secondary:
      - context_switches
      - migrations

  io_perf:
    primary:
      - name: iops
        direction: higher
        unit: iops
        chart: delta_bar
        regression: -3%
      - name: p99_latency_us
        direction: lower
        unit: us
        chart: latency_bar
        regression: +8%
    secondary:
      - bandwidth_bytes_per_sec
      - cpu_utilization
      - io_pressure

  latency:
    primary:
      - name: p99_latency_us
        direction: lower
        unit: us
        chart: latency_bar
        regression: +5%
      - name: p999_latency_us
        direction: lower
        unit: us
        chart: latency_bar
        regression: +10%
    secondary:
      - throughput
      - task_clock_msec
      - context_switches
      - migrations

  realtime_latency:
    primary:
      - name: max_latency_us
        direction: lower
        unit: us
        chart: latency_bar
        regression: +10%
      - name: avg_latency_us
        direction: lower
        unit: us
        chart: latency_bar
        regression: +5%
    secondary:
      - min_latency_us
      - context_switches
      - migrations

  build_perf:
    primary:
      - name: elapsed_time_sec
        direction: lower
        unit: s
        chart: delta_bar
        regression: +5%
      - name: throughput
        direction: higher
        unit: builds/s
        chart: delta_bar
        regression: -5%
    secondary:
      - cpu_utilization
      - context_switches
      - migrations

  fairness:
    primary:
      - name: cpu_share_error
        direction: lower
        unit: "%"
        chart: delta_bar
        regression: +5%
      - name: max_wait_time
        direction: lower
        unit: us
        chart: latency_bar
        regression: +10%
    secondary:
      - throughput
      - p99_latency
      - per_cgroup_runtime

  service_perf:
    primary:
      - name: throughput
        direction: higher
        unit: qps
        chart: delta_bar
        regression: -5%
      - name: p99_latency_us
        direction: lower
        unit: us
        chart: latency_bar
        regression: +5%
      - name: p999_latency_us
        direction: lower
        unit: us
        chart: latency_bar
        regression: +10%
      - name: elapsed_time_sec
        direction: lower
        unit: s
        chart: delta_bar
        regression: +5%
    secondary:
      - get_qps
      - set_qps
      - task_clock_msec
      - context_switches
      - migrations

  context_switch:
    primary:
      - name: context_switch_clocks
        direction: lower
        unit: clocks
        chart: delta_bar
        regression: +10%
      - name: elapsed_time_sec
        direction: lower
        unit: s
        chart: delta_bar
        regression: +10%
    secondary:
      - cpu_utilization

  os_latency:
    primary:
      - name: us_per_thread
        direction: lower
        unit: us
        chart: latency_bar
        regression: +5%
      - name: us_per_process
        direction: lower
        unit: us
        chart: latency_bar
        regression: +5%
      - name: us_per_launch
        direction: lower
        unit: us
        chart: latency_bar
        regression: +5%
      - name: us_per_file
        direction: lower
        unit: us
        chart: latency_bar
        regression: +5%
      - name: us_per_alloc
        direction: lower
        unit: us
        chart: latency_bar
        regression: +5%
      - name: elapsed_time_sec
        direction: lower
        unit: s
        chart: delta_bar
        regression: +5%
    secondary:
      - cpu_utilization

  ipc_throughput:
    primary:
      - name: throughput
        direction: higher
        unit: msg/s
        chart: delta_bar
        regression: -5%
      - name: elapsed_time_sec
        direction: lower
        unit: s
        chart: delta_bar
        regression: +5%
    secondary:
      - bandwidth_mb_per_sec
      - context_switches

  memory_latency:
    primary:
      - name: avg_page_latency_us
        direction: lower
        unit: us
        chart: latency_bar
        regression: +10%
      - name: benchmark_mutex_lock_unlock__ns
        direction: lower
        unit: ns
        chart: latency_bar
        regression: +5%
      - name: elapsed_time_sec
        direction: lower
        unit: s
        chart: delta_bar
        regression: +5%
    secondary:
      - avg_page_latency_clocks
      - cpu_utilization

  classed_mixed:
    primary:
      - name: batch_throughput
        direction: higher
        unit: bogo-ops/s
        chart: delta_bar
        regression: -5%
      - name: p99_latency_us
        direction: lower
        unit: us
        chart: latency_bar
        regression: +5%
    secondary:
      - task_clock_msec
      - context_switches
      - migrations
      - elapsed_time_sec

suites:
  cpu_smoke:
    benches: [hackbench_smoke]
    metric_profile: cpu_throughput

  latency_smoke:
    benches: [schbench_smoke]
    metric_profile: latency

  cpu_bound:
    benches: [hackbench, stress_ng_cpu]
    metric_profile: cpu_throughput

  sched_ipc:
    benches: [perf_sched_pipe, perf_sched_messaging]
    metric_profile: sched_ipc_perf

  scalability:
    benches: [will_it_scale_context_switch]
    metric_profile: cpu_throughput

  io_bound:
    benches: [fio_randread, fio_randwrite]
    metric_profile: io_perf

  latency:
    benches: [schbench]
    metric_profile: latency

  realtime_latency:
    benches: [cyclictest]
    metric_profile: realtime_latency

  service:
    benches: [redis_benchmark]
    metric_profile: service_perf

  kernel_build:
    benches: [kernel_build_bzimage]
    metric_profile: build_perf

  fairness:
    benches: [cgroup_fairness]
    metric_profile: fairness

  context_switch:
    benches: [ctx_clock]
    metric_profile: context_switch

  os_bench:
    benches: [osbench_create_threads, osbench_create_processes, osbench_launch_programs, osbench_create_files, osbench_mem_alloc]
    metric_profile: os_latency

  ipc:
    benches: [ipc_pipe, ipc_fifo, ipc_socketpair, ipc_tcp]
    metric_profile: ipc_throughput

  memory_latency:
    benches: [pmbench_randread, mutex_lock_unlock]
    metric_profile: memory_latency

  scx_agent_classed_sacrificial:
    benches: [classed_perf_hackbench]
    metric_profile: cpu_throughput

  scx_agent_classed_small_batch:
    benches: [classed_perf_stress_ng]
    metric_profile: cpu_throughput

  scx_agent_classed_perf_cpu:
    benches: [classed_perf_hackbench, classed_perf_stress_ng]
    metric_profile: cpu_throughput

  scx_agent_classed_perf_latency:
    benches: [classed_perf_schbench]
    metric_profile: latency

  scx_agent_classed_perf_mixed:
    benches: [classed_perf_mixed]
    metric_profile: classed_mixed

  scx_agent_classed_perf_service:
    benches: [classed_perf_redis]
    metric_profile: service_perf

benches:
  # Dedicated definitions keep warmup and measurement identical across every
  # A/A and A/B pair without changing the existing benchmark plans.
  classed_perf_hackbench:
    host_support_files: [bench/benchmarks/perf_stat_wrapper.py]
    measurement:
      command: python3
      args: [/tmp/scx-bench-workload.d/perf_stat_wrapper.py, --, python3, bench/benchmarks/hackbench.py, --, '16', thread, '20000']
      timeout_seconds: 360
    warmup:
      command: python3
      args: [bench/benchmarks/hackbench.py, --, '4', thread, '2000']
      timeout_seconds: 60

  classed_perf_stress_ng:
    host_support_files: [bench/benchmarks/perf_stat_wrapper.py]
    measurement:
      command: python3
      args: [/tmp/scx-bench-workload.d/perf_stat_wrapper.py, --, python3, bench/benchmarks/stress_ng.py, --, --cpu, '0', --timeout, 60s, --metrics-brief]
      timeout_seconds: 120
    warmup:
      command: python3
      args: [bench/benchmarks/stress_ng.py, --, --cpu, '0', --timeout, 10s, --metrics-brief]
      timeout_seconds: 30

  classed_perf_schbench:
    host_support_files: [bench/benchmarks/perf_stat_wrapper.py]
    measurement:
      command: python3
      args: [/tmp/scx-bench-workload.d/perf_stat_wrapper.py, --, python3, bench/benchmarks/schbench.py, --, -m, '4', -t, '16', -r, '60']
      timeout_seconds: 120
    warmup:
      command: python3
      args: [bench/benchmarks/schbench.py, --, -m, '4', -t, '16', -r, '10']
      timeout_seconds: 30

  classed_perf_mixed:
    host_support_files:
      - bench/benchmarks/perf_stat_wrapper.py
      - bench/benchmarks/mixed_class.py
      - bench/benchmarks/schbench.py
      - bench/benchmarks/stress_ng.py
      - bench/benchmarks/util.py
    measurement:
      command: python3
      args: [/tmp/scx-bench-workload.d/perf_stat_wrapper.py, --, python3, /tmp/scx-bench-workload.d/mixed_class.py, --batch-workers, '4', --batch-seconds, '65', --batch-warmup-seconds, '5', --, -m, '4', -t, '16', -r, '60']
      timeout_seconds: 150
    warmup:
      command: python3
      args: [/tmp/scx-bench-workload.d/mixed_class.py, --batch-workers, '4', --batch-seconds, '12', --batch-warmup-seconds, '1', --, -m, '2', -t, '8', -r, '10']
      timeout_seconds: 45

  classed_perf_redis:
    host_support_files: [bench/benchmarks/perf_stat_wrapper.py]
    measurement:
      command: python3
      args: [/tmp/scx-bench-workload.d/perf_stat_wrapper.py, --, python3, bench/benchmarks/redis.py, --requests, '1000000', --clients, '100', --tests, 'get,set']
      timeout_seconds: 180
    warmup:
      command: python3
      args: [bench/benchmarks/redis.py, --requests, '100000', --clients, '50', --tests, 'get,set']
      timeout_seconds: 60

  hackbench_smoke:
    measurement:
      command: python3
      args: ["bench/benchmarks/hackbench.py", "--", "2", "thread", "1000"]
      timeout_seconds: 60

  schbench_smoke:
    measurement:
      command: python3
      args: ["bench/benchmarks/schbench.py", "--", "-m", "1", "-t", "1", "-r", "10"]
      timeout_seconds: 60

  hackbench:
    measurement:
      command: python3
      args: ["bench/benchmarks/hackbench.py", "--", "16", "thread", "10000"]
      timeout_seconds: 300

  stress_ng_cpu:
    measurement:
      command: python3
      args: ["bench/benchmarks/stress_ng.py", "--", "--cpu", "0", "--timeout", "60s", "--metrics-brief"]
      timeout_seconds: 120

  perf_sched_pipe:
    measurement:
      command: python3
      args: ["bench/benchmarks/perf_sched.py", "pipe", "--", "-l", "10000"]
      timeout_seconds: 120

  perf_sched_messaging:
    measurement:
      command: python3
      args: ["bench/benchmarks/perf_sched.py", "messaging", "--", "-l", "1000", "-g", "4"]
      timeout_seconds: 120

  will_it_scale_context_switch:
    measurement:
      command: python3
      args: ["bench/benchmarks/will_it_scale.py", "--", "context_switch1"]
      timeout_seconds: 180

  fio_randread:
    measurement:
      command: python3
      args: ["bench/benchmarks/fio.py", "--", "--name=randread", "--rw=randread", "--bs=4k", "--size=1G", "--runtime=60", "--time_based", "--output-format=json"]
      timeout_seconds: 120

  fio_randwrite:
    measurement:
      command: python3
      args: ["bench/benchmarks/fio.py", "--", "--name=randwrite", "--rw=randwrite", "--bs=4k", "--size=1G", "--runtime=60", "--time_based", "--output-format=json"]
      timeout_seconds: 120

  schbench:
    measurement:
      command: python3
      args: ["bench/benchmarks/schbench.py", "--", "-m", "4", "-t", "16", "-r", "60"]
      timeout_seconds: 120
    warmup:
      command: python3
      args: ["bench/benchmarks/schbench.py", "--", "-m", "4", "-t", "16", "-r", "10"]
      timeout_seconds: 30

  cyclictest:
    measurement:
      command: python3
      args: ["bench/benchmarks/cyclictest.py", "--", "-q", "-D", "60s", "-p", "80", "-i", "1000"]
      timeout_seconds: 120

  kernel_build_bzimage:
    measurement:
      command: python3
      args: ["bench/benchmarks/kernel_build.py", "--source", null, "--target", "bzImage", "--jobs", "0"]
      timeout_seconds: 1800

  cgroup_fairness:
    measurement:
      command: python3
      args: ["bench/benchmarks/generic.py", "--", "bench/workloads/cgroup-fairness", "--duration", "60"]
      timeout_seconds: 120

  redis_benchmark:
    measurement:
      command: python3
      args: ["bench/benchmarks/redis.py", "--requests", "10000", "--clients", "50", "--tests", "get,set"]
      timeout_seconds: 120

  ctx_clock:
    measurement:
      command: python3
      args: ["bench/benchmarks/ctx_clock.py"]
      timeout_seconds: 30

  osbench_create_threads:
    measurement:
      command: python3
      args: ["bench/benchmarks/osbench.py", "create_threads"]
      timeout_seconds: 30

  osbench_create_processes:
    measurement:
      command: python3
      args: ["bench/benchmarks/osbench.py", "create_processes"]
      timeout_seconds: 30

  osbench_launch_programs:
    measurement:
      command: python3
      args: ["bench/benchmarks/osbench.py", "launch_programs"]
      timeout_seconds: 30

  osbench_create_files:
    measurement:
      command: python3
      args: ["bench/benchmarks/osbench.py", "create_files"]
      timeout_seconds: 30

  osbench_mem_alloc:
    measurement:
      command: python3
      args: ["bench/benchmarks/osbench.py", "mem_alloc"]
      timeout_seconds: 30

  ipc_pipe:
    measurement:
      command: python3
      args: ["bench/benchmarks/ipc_benchmark.py", "pipe", "--", "128", "9000000"]
      timeout_seconds: 30

  ipc_fifo:
    measurement:
      command: python3
      args: ["bench/benchmarks/ipc_benchmark.py", "fifo", "--", "128", "9000000"]
      timeout_seconds: 30

  ipc_socketpair:
    measurement:
      command: python3
      args: ["bench/benchmarks/ipc_benchmark.py", "socketpair", "--", "128", "9000000"]
      timeout_seconds: 30

  ipc_tcp:
    measurement:
      command: python3
      args: ["bench/benchmarks/ipc_benchmark.py", "tcp", "--", "128", "1000000"]
      timeout_seconds: 30

  sysbench_cpu:
    measurement:
      command: python3
      args: ["bench/benchmarks/sysbench_wrapper.py", "--", "cpu", "--threads=0", "--time=30", "run"]
      timeout_seconds: 60

  sysbench_memory:
    measurement:
      command: python3
      args: ["bench/benchmarks/sysbench_wrapper.py", "--", "memory", "--threads=0", "--time=30", "run"]
      timeout_seconds: 60

  sysbench_threads:
    measurement:
      command: python3
      args: ["bench/benchmarks/sysbench_wrapper.py", "--", "threads", "--threads=0", "--time=30", "run"]
      timeout_seconds: 60

  sysbench_mutex:
    measurement:
      command: python3
      args: ["bench/benchmarks/sysbench_wrapper.py", "--", "mutex", "--threads=0", "--time=30", "run"]
      timeout_seconds: 60

  pmbench_randread:
    measurement:
      command: python3
      args: ["bench/benchmarks/pmbench_wrapper.py", "--", "-j", "0", "-r", "100", "15"]
      timeout_seconds: 30

  mutex_lock_unlock:
    measurement:
      command: python3
      args: ["bench/benchmarks/mutex_benchmark.py", "--", "--benchmark_color=false", "--benchmark_filter=benchmark_mutex_lock_unlock.std::mutex.", "--benchmark_min_time=1s"]
      timeout_seconds: 30

  t_test1:
    measurement:
      command: python3
      args: ["bench/benchmarks/t_test1.py", "--", "0"]
      timeout_seconds: 30
