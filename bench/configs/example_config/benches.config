bench_defaults:
  post_warmup_settle_seconds: 2
  cooldown_seconds: 1

metric_profiles:
  batch_only:
    primary:
    - name: throughput
      direction: higher
      unit: bogo-ops/s
      chart: delta_bar
      regression: -3%
    secondary:
    - elapsed_time_sec
    - bogo_ops
    - stress_elapsed_time_sec
    - stress_reported_throughput
    - cpu_time_throughput
    - cpu_utilization
    - context_switches
    - migrations
  latency_single:
    primary:
    - name: p99_latency_us
      direction: lower
      unit: us
      chart: latency_bar
      regression: +5%
    - name: p999_latency_us
      direction: lower
      unit: us
      chart: latency_bar
      regression: +10%
    - name: throughput
      direction: higher
      unit: requests/s
      chart: delta_bar
      regression: -3%
    secondary:
    - request_p50_latency_us
    - request_p90_latency_us
    - wakeup_p50_latency_us
    - wakeup_p90_latency_us
    - wakeup_p99_latency_us
    - wakeup_p999_latency_us
    - elapsed_time_sec
    - context_switches
    - migrations
  mixed_latency:
    primary:
    - name: p99_latency_us
      direction: lower
      unit: us
      chart: latency_bar
      regression: +10%
    - name: p999_latency_us
      direction: lower
      unit: us
      chart: latency_bar
      regression: +15%
    - name: batch_throughput
      direction: higher
      unit: bogo-ops/s
      chart: delta_bar
      regression: -10%
    secondary:
    - throughput
    - request_p50_latency_us
    - request_p90_latency_us
    - wakeup_p50_latency_us
    - wakeup_p90_latency_us
    - wakeup_p99_latency_us
    - wakeup_p999_latency_us
    - context_switches
    - migrations

suites:
  batch_only_perf:
    benches: [stress_ng_batch_oversubscribed_perf]
    metric_profile: batch_only
  latency_only_perf:
    benches: [schbench_latency_contended_perf]
    metric_profile: latency_single
  mixed_class_fixed_rps_perf:
    benches: [mixed_schbench_stress_fixed_rps_100_perf]
    metric_profile: mixed_latency

benches:
  stress_ng_batch_oversubscribed_perf:
    measurement:
      command: bench/workloads/bin/perf
      args: [stat, -a, -x, ',', -e, 'context-switches,cpu-migrations', -o, /scx_bench_out/perf_stat.csv, --, python3, bench/benchmarks/stress_ng.py, --, --cpu, '4', --timeout, 30s, --metrics-brief]
      timeout_seconds: 90
    warmup:
      command: python3
      args: [bench/benchmarks/stress_ng.py, --, --cpu, '4', --timeout, 5s, --metrics-brief]
      timeout_seconds: 20
  schbench_latency_contended_perf:
    measurement:
      command: bench/workloads/bin/perf
      args: [stat, -a, -x, ',', -e, 'context-switches,cpu-migrations', -o, /scx_bench_out/perf_stat.csv, --, python3, bench/benchmarks/schbench.py, --, -m, '1', -t, '4', -n, '5', -r, '30']
      timeout_seconds: 90
    warmup:
      command: python3
      args: [bench/benchmarks/schbench.py, --, -m, '1', -t, '4', -n, '5', -r, '5']
      timeout_seconds: 20
  mixed_schbench_stress_fixed_rps_100_perf:
    measurement:
      command: bench/workloads/bin/perf
      args: [stat, -a, -x, ',', -e, 'context-switches,cpu-migrations', -o, /scx_bench_out/perf_stat.csv, --, python3, bench/benchmarks/mixed_class.py, --batch-workers, '2', --batch-seconds, '31', --batch-warmup-seconds, '1', --, -m, '1', -t, '1', -R, '100', -n, '5', -r, '30', -i, '10']
      timeout_seconds: 120
    warmup:
      command: python3
      args: [bench/benchmarks/mixed_class.py, --batch-workers, '2', --batch-seconds, '7', --batch-warmup-seconds, '1', --, -m, '1', -t, '1', -R, '100', -n, '5', -r, '5', -i, '10']
      timeout_seconds: 20
