bench_defaults:
  post_warmup_settle_seconds: 2
  cooldown_seconds: 1

metric_profiles:
  cpu_throughput:
    primary:
    - name: throughput
      direction: higher
      unit: ops/s
      chart: delta_bar
      regression: -3%
    - name: elapsed_time_sec
      direction: lower
      unit: s
      chart: delta_bar
      regression: +3%
    secondary:
    - cpu_utilization
    - context_switches
    - migrations

  sched_ipc_perf:
    primary:
    - name: throughput
      direction: higher
      unit: ops/s
      chart: delta_bar
      regression: -5%
    - name: latency_us_per_op
      direction: lower
      unit: us/op
      chart: latency_bar
      regression: +5%
    - name: elapsed_time_sec
      direction: lower
      unit: s
      chart: delta_bar
      regression: +5%
    secondary:
    - context_switches
    - migrations

  io_perf:
    primary:
    - name: iops
      direction: higher
      unit: iops
      chart: delta_bar
      regression: -3%
    - name: p99_latency_us
      direction: lower
      unit: us
      chart: latency_bar
      regression: +8%
    secondary:
    - bandwidth_bytes_per_sec
    - cpu_utilization
    - io_pressure

  latency:
    primary:
    - name: p99_latency_us
      direction: lower
      unit: us
      chart: latency_bar
      regression: +5%
    - name: p999_latency_us
      direction: lower
      unit: us
      chart: latency_bar
      regression: +10%
    secondary:
    - throughput
    - context_switches
    - migrations

  realtime_latency:
    primary:
    - name: max_latency_us
      direction: lower
      unit: us
      chart: latency_bar
      regression: +10%
    - name: avg_latency_us
      direction: lower
      unit: us
      chart: latency_bar
      regression: +5%
    secondary:
    - min_latency_us
    - context_switches
    - migrations

  build_perf:
    primary:
    - name: elapsed_time_sec
      direction: lower
      unit: s
      chart: delta_bar
      regression: +5%
    - name: throughput
      direction: higher
      unit: builds/s
      chart: delta_bar
      regression: -5%
    secondary:
    - cpu_utilization
    - context_switches
    - migrations

  fairness:
    primary:
    - name: cpu_share_error
      direction: lower
      unit: '%'
      chart: delta_bar
      regression: +5%
    - name: max_wait_time
      direction: lower
      unit: us
      chart: latency_bar
      regression: +10%
    secondary:
    - throughput
    - p99_latency
    - per_cgroup_runtime

  service_perf:
    primary:
    - name: throughput
      direction: higher
      unit: qps
      chart: delta_bar
      regression: -5%
    - name: elapsed_time_sec
      direction: lower
      unit: s
      chart: delta_bar
      regression: +5%
    secondary:
    - get_qps
    - set_qps

  context_switch:
    primary:
    - name: context_switch_clocks
      direction: lower
      unit: clocks
      chart: delta_bar
      regression: +10%
    - name: elapsed_time_sec
      direction: lower
      unit: s
      chart: delta_bar
      regression: +10%
    secondary:
    - cpu_utilization

  os_latency:
    primary:
    - name: us_per_thread
      direction: lower
      unit: us
      chart: latency_bar
      regression: +5%
    - name: us_per_process
      direction: lower
      unit: us
      chart: latency_bar
      regression: +5%
    - name: us_per_launch
      direction: lower
      unit: us
      chart: latency_bar
      regression: +5%
    - name: us_per_file
      direction: lower
      unit: us
      chart: latency_bar
      regression: +5%
    - name: us_per_alloc
      direction: lower
      unit: us
      chart: latency_bar
      regression: +5%
    - name: elapsed_time_sec
      direction: lower
      unit: s
      chart: delta_bar
      regression: +5%
    secondary:
    - cpu_utilization

  ipc_throughput:
    primary:
    - name: throughput
      direction: higher
      unit: msg/s
      chart: delta_bar
      regression: -5%
    - name: elapsed_time_sec
      direction: lower
      unit: s
      chart: delta_bar
      regression: +5%
    secondary:
    - bandwidth_mb_per_sec
    - context_switches

  memory_latency:
    primary:
    - name: avg_page_latency_us
      direction: lower
      unit: us
      chart: latency_bar
      regression: +10%
    - name: benchmark_mutex_lock_unlock__ns
      direction: lower
      unit: ns
      chart: latency_bar
      regression: +5%
    - name: elapsed_time_sec
      direction: lower
      unit: s
      chart: delta_bar
      regression: +5%
    secondary:
    - avg_page_latency_clocks
    - cpu_utilization

  storage_kv:
    primary:
    - name: throughput
      direction: higher
      unit: ops/s
      chart: delta_bar
      regression: -5%
    - name: elapsed_time_sec
      direction: lower
      unit: s
      chart: delta_bar
      regression: +5%
    secondary:
    - overall_ops_per_sec
    - avg_latency_ms
    - p99_latency_ms

  ann_cpu:
    primary:
    - name: qps
      direction: higher
      unit: qps
      chart: delta_bar
      regression: -5%
    - name: p99_latency_ms
      direction: lower
      unit: ms
      chart: latency_bar
      regression: +10%
    - name: build_time_sec
      direction: lower
      unit: s
      chart: delta_bar
      regression: +5%
    secondary:
    - recall
    - avg_latency_ms
    - p95_latency_ms

  memory_bandwidth:
    primary:
    - name: throughput
      direction: higher
      unit: MB/s
      chart: delta_bar
      regression: -5%
    - name: elapsed_time_sec
      direction: lower
      unit: s
      chart: delta_bar
      regression: +5%
    secondary:
    - bandwidth_mbps
    - execution_time_sec

  web_service:
    primary:
    - name: throughput
      direction: higher
      unit: req/s
      chart: delta_bar
      regression: -5%
    - name: p99_latency_ms
      direction: lower
      unit: ms
      chart: latency_bar
      regression: +10%
    secondary:
    - p50_latency_ms
    - p999_latency_ms
    - transfer_bytes_per_sec

  fileio_perf:
    primary:
    - name: throughput
      direction: higher
      unit: MiB/s
      chart: delta_bar
      regression: -5%
    - name: p95_latency_ms
      direction: lower
      unit: ms
      chart: latency_bar
      regression: +10%
    secondary:
    - reads_per_sec
    - writes_per_sec
    - fsyncs_per_sec

benches:
  hackbench_smoke:
    measurement:
      command: python3
      args:
      - bench/benchmarks/hackbench.py
      - --
      - '2'
      - thread
      - '1000'
      timeout_seconds: 60

  schbench_smoke:
    measurement:
      command: python3
      args:
      - bench/benchmarks/schbench.py
      - --
      - -m
      - '1'
      - -t
      - '1'
      - -r
      - '10'
      timeout_seconds: 60

  hackbench:
    measurement:
      command: python3
      args:
      - bench/benchmarks/hackbench.py
      - --
      - '16'
      - thread
      - '10000'
      timeout_seconds: 300

  stress_ng_cpu:
    measurement:
      command: python3
      args:
      - bench/benchmarks/stress_ng.py
      - --
      - --cpu
      - '0'
      - --timeout
      - 60s
      - --metrics-brief
      timeout_seconds: 120

  perf_sched_pipe:
    measurement:
      command: python3
      args:
      - bench/benchmarks/perf_sched.py
      - pipe
      - --
      - -l
      - '10000'
      timeout_seconds: 120

  perf_sched_messaging:
    measurement:
      command: python3
      args:
      - bench/benchmarks/perf_sched.py
      - messaging
      - --
      - -l
      - '1000'
      - -g
      - '4'
      timeout_seconds: 120

  will_it_scale_context_switch:
    measurement:
      command: python3
      args:
      - bench/benchmarks/will_it_scale.py
      - --
      - context_switch1
      timeout_seconds: 180

  fio_randread:
    measurement:
      command: python3
      args:
      - bench/benchmarks/fio.py
      - --
      - --name=randread
      - --rw=randread
      - --bs=4k
      - --size=1G
      - --runtime=60
      - --time_based
      - --output-format=json
      timeout_seconds: 120

  fio_randwrite:
    measurement:
      command: python3
      args:
      - bench/benchmarks/fio.py
      - --
      - --name=randwrite
      - --rw=randwrite
      - --bs=4k
      - --size=1G
      - --runtime=60
      - --time_based
      - --output-format=json
      timeout_seconds: 120

  schbench:
    measurement:
      command: python3
      args:
      - bench/benchmarks/schbench.py
      - --
      - -m
      - '4'
      - -t
      - '16'
      - -r
      - '60'
      timeout_seconds: 120
    warmup:
      command: python3
      args:
      - bench/benchmarks/schbench.py
      - --
      - -m
      - '4'
      - -t
      - '16'
      - -r
      - '10'
      timeout_seconds: 30

  cyclictest:
    measurement:
      command: python3
      args:
      - bench/benchmarks/cyclictest.py
      - --
      - -q
      - -D
      - 60s
      - -p
      - '80'
      - -i
      - '1000'
      timeout_seconds: 120

  kernel_build_bzimage:
    measurement:
      command: python3
      args:
      - bench/benchmarks/kernel_build.py
      - --source
      - null
      - --target
      - bzImage
      - --jobs
      - '0'
      timeout_seconds: 1800

  cgroup_fairness:
    measurement:
      command: python3
      args:
      - bench/benchmarks/generic.py
      - --
      - bench/workloads/cgroup-fairness
      - --duration
      - '60'
      timeout_seconds: 120

  redis_benchmark:
    measurement:
      command: python3
      args:
      - bench/benchmarks/redis.py
      - --requests
      - '10000'
      - --clients
      - '50'
      - --tests
      - get,set
      timeout_seconds: 120

  ctx_clock:
    measurement:
      command: python3
      args:
      - bench/benchmarks/ctx_clock.py
      timeout_seconds: 30

  osbench_create_threads:
    measurement:
      command: python3
      args:
      - bench/benchmarks/osbench.py
      - create_threads
      timeout_seconds: 30

  osbench_create_processes:
    measurement:
      command: python3
      args:
      - bench/benchmarks/osbench.py
      - create_processes
      timeout_seconds: 30

  osbench_launch_programs:
    measurement:
      command: python3
      args:
      - bench/benchmarks/osbench.py
      - launch_programs
      timeout_seconds: 30

  osbench_create_files:
    measurement:
      command: python3
      args:
      - bench/benchmarks/osbench.py
      - create_files
      timeout_seconds: 30

  osbench_mem_alloc:
    measurement:
      command: python3
      args:
      - bench/benchmarks/osbench.py
      - mem_alloc
      timeout_seconds: 30

  ipc_pipe:
    measurement:
      command: python3
      args:
      - bench/benchmarks/ipc_benchmark.py
      - pipe
      - --
      - '128'
      - '9000000'
      timeout_seconds: 30

  ipc_fifo:
    measurement:
      command: python3
      args:
      - bench/benchmarks/ipc_benchmark.py
      - fifo
      - --
      - '128'
      - '9000000'
      timeout_seconds: 30

  ipc_socketpair:
    measurement:
      command: python3
      args:
      - bench/benchmarks/ipc_benchmark.py
      - socketpair
      - --
      - '128'
      - '9000000'
      timeout_seconds: 30

  ipc_tcp:
    measurement:
      command: python3
      args:
      - bench/benchmarks/ipc_benchmark.py
      - tcp
      - --
      - '128'
      - '1000000'
      timeout_seconds: 30

  sysbench_cpu:
    measurement:
      command: python3
      args:
      - bench/benchmarks/sysbench_wrapper.py
      - --
      - cpu
      - --threads=0
      - --time=30
      - run
      timeout_seconds: 60

  sysbench_memory:
    measurement:
      command: python3
      args:
      - bench/benchmarks/sysbench_wrapper.py
      - --
      - memory
      - --threads=0
      - --time=30
      - run
      timeout_seconds: 60

  sysbench_threads:
    measurement:
      command: python3
      args:
      - bench/benchmarks/sysbench_wrapper.py
      - --
      - threads
      - --threads=0
      - --time=30
      - run
      timeout_seconds: 60

  sysbench_mutex:
    measurement:
      command: python3
      args:
      - bench/benchmarks/sysbench_wrapper.py
      - --
      - mutex
      - --threads=0
      - --time=30
      - run
      timeout_seconds: 60

  pmbench_randread:
    measurement:
      command: python3
      args:
      - bench/benchmarks/pmbench_wrapper.py
      - --
      - -j
      - '0'
      - -r
      - '100'
      - '15'
      timeout_seconds: 30

  mutex_lock_unlock:
    measurement:
      command: python3
      args:
      - bench/benchmarks/mutex_benchmark.py
      - --
      - --benchmark_color=false
      - --benchmark_filter=benchmark_mutex_lock_unlock.std::mutex.
      - --benchmark_min_time=1s
      timeout_seconds: 30

  t_test1:
    measurement:
      command: python3
      args:
      - bench/benchmarks/t_test1.py
      - --
      - '0'
      timeout_seconds: 30

  stress_ng_vm:
    measurement:
      command: python3
      args:
      - bench/benchmarks/stress_ng.py
      - --
      - --vm
      - '2'
      - --vm-bytes
      - 1G
      - --timeout
      - 60s
      - --metrics-brief
      timeout_seconds: 120

  stress_ng_io:
    measurement:
      command: python3
      args:
      - bench/benchmarks/stress_ng.py
      - --
      - --io
      - '2'
      - --timeout
      - 60s
      - --metrics-brief
      timeout_seconds: 120

  stress_ng_sched:
    measurement:
      command: python3
      args:
      - bench/benchmarks/stress_ng.py
      - --
      - --cpu-sched
      - '2'
      - --timeout
      - 60s
      - --metrics-brief
      timeout_seconds: 120

  stress_ng_matrix:
    measurement:
      command: python3
      args:
      - bench/benchmarks/stress_ng.py
      - --
      - --cpu
      - '0'
      - --cpu-method
      - matrixprod
      - --timeout
      - 60s
      - --metrics-brief
      timeout_seconds: 120

  linux_build_tinyconfig:
    measurement:
      command: python3
      args:
      - bench/benchmarks/linux_build_config.py
      - --source
      - null
      - --config
      - tinyconfig
      - --target
      - bzImage
      - --jobs
      - '0'
      - --clean-between
      timeout_seconds: 900

  linux_build_defconfig:
    measurement:
      command: python3
      args:
      - bench/benchmarks/linux_build_config.py
      - --source
      - null
      - --config
      - defconfig
      - --target
      - bzImage
      - --jobs
      - '0'
      - --clean-between
      timeout_seconds: 1800

  linux_build_allnoconfig:
    measurement:
      command: python3
      args:
      - bench/benchmarks/linux_build_config.py
      - --source
      - null
      - --config
      - allnoconfig
      - --target
      - bzImage
      - --jobs
      - '0'
      - --clean-between
      timeout_seconds: 900

  sysbench_fileio_rndrw:
    measurement:
      command: python3
      args:
      - bench/benchmarks/sysbench_fileio.py
      - --file-total-size
      - 1G
      - --file-test-mode
      - rndrw
      - --threads
      - '4'
      - --time
      - '30'
      timeout_seconds: 180

  memtier_mixed:
    measurement:
      command: python3
      args:
      - bench/benchmarks/memtier.py
      - --clients
      - '50'
      - --threads
      - '4'
      - --requests
      - '100000'
      - --data-size
      - '32'
      - --pipeline
      - '1'
      - --ratio
      - '1:10'
      timeout_seconds: 180

  redis_benchmark_sweep:
    measurement:
      command: python3
      args:
      - bench/benchmarks/redis.py
      - --requests
      - '100000'
      - --clients
      - '100'
      - --tests
      - get,set,incr,lpush,lpop
      timeout_seconds: 180

  rocksdb_fillread:
    measurement:
      command: python3
      args:
      - bench/benchmarks/rocksdb.py
      - --benchmarks
      - fillrandom,readrandom
      - --num
      - '500000'
      - --reads
      - '1000000'
      - --value-size
      - '100'
      timeout_seconds: 600

  rocksdb_mixed:
    measurement:
      command: python3
      args:
      - bench/benchmarks/rocksdb.py
      - --benchmarks
      - fillrandom,readwhilewriting
      - --num
      - '300000'
      - --reads
      - '500000'
      - --threads
      - '4'
      - --value-size
      - '100'
      timeout_seconds: 600

  pyvsag_hnsw:
    measurement:
      command: python3
      args:
      - bench/benchmarks/pyvsag.py
      - --dim
      - '128'
      - --num-elements
      - '50000'
      - --num-queries
      - '1000'
      - --k
      - '10'
      timeout_seconds: 600

  memory_bandwidth_random:
    measurement:
      command: python3
      args:
      - bench/benchmarks/memory_bandwidth.py
      - --buffer-size
      - '1073741824'
      - --threads
      - '0'
      - --duration
      - '5'
      - --read-ratio
      - '0.5'
      timeout_seconds: 120

  memory_bandwidth_sequential:
    measurement:
      command: python3
      args:
      - bench/benchmarks/memory_bandwidth.py
      - --buffer-size
      - '1073741824'
      - --threads
      - '0'
      - --duration
      - '5'
      - --read-ratio
      - '0.5'
      - --sequential
      timeout_seconds: 120

  nginx_wrk2_medium:
    measurement:
      command: python3
      args:
      - bench/benchmarks/nginx_wrk2.py
      - --threads
      - '4'
      - --connections
      - '50'
      - --duration
      - '10'
      - --rate
      - '1000'
      timeout_seconds: 120
